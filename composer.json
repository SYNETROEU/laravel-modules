{
    "name": "synetro/laravel-modules",
    "description": "Modern Laravel module system with first-class Inertia.js + React support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Synetro"
        }
    ],
    "homepage": "https://github.com/SYNETROEU/laravel-modules",
    "support": {
        "issues": "https://github.com/SYNETROEU/laravel-modules/issues",
        "source": "https://github.com/SYNETROEU/laravel-modules"
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Synetro\\LaravelModules\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Synetro\\LaravelModules\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Synetro\\LaravelModules\\Providers\\LaravelModulesServiceProvider"
            ],
            "aliases": {
                "Modules": "Synetro\\LaravelModules\\Facades\\Modules"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
